package com.xaubuddy.app;

public class MT5Connector {

    private String status = "DISCONNECTED";


    public void connect(
            String server,
            String account,
            String password
    ){

        if(
            server.length() > 0 &&
            account.length() > 0 &&
            password.length() > 0
        ){

            status = "CONNECTED";

        }
        else{

            status = "LOGIN REQUIRED";

        }

    }


    public String getStatus(){

        return status;

    }

}
